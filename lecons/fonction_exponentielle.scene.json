{
  "titre": "La fonction exponentielle",
  "niveau": "Maths · 1re spé",
  "etapes": [
    {
      "sous_titre": "Une seule fonction est égale à sa propre dérivée et vaut 1 en 0…",
      "actions": [
        {"type": "formule", "ligne": 1, "texte": "f' = f  et  f(0) = 1"}
      ]
    },
    {
      "sous_titre": "C'est l'exponentielle : on la note exp(x) ou e^{x}.",
      "actions": [
        {"type": "formule", "ligne": 2, "texte": "exp(x) = e^{x}", "couleur": "bleu"}
      ]
    },
    {
      "sous_titre": "Traçons sa courbe.",
      "actions": [
        {"type": "repere", "xmin": -3, "xmax": 3, "ymin": -1, "ymax": 8, "pas_x": 1, "pas_y": 2},
        {"type": "courbe", "expr": "exp(x)", "couleur": "bleu", "label": "y = e^{x}", "label_x": 1.6, "position_label": "hg"}
      ]
    },
    {
      "sous_titre": "Elle passe par (0 ; 1) : e^{0} = 1.",
      "actions": [
        {"type": "point", "x": 0, "y": 1, "label": "(0 ; 1)", "couleur": "jaune", "position_label": "hg"}
      ]
    },
    {
      "sous_titre": "En x = 1, elle vaut e ≈ 2,718.",
      "actions": [
        {"type": "segment", "de": [1, 0], "a": [1, 2.718], "pointille": true},
        {"type": "segment", "de": [0, 2.718], "a": [1, 2.718], "pointille": true, "en_meme_temps": true},
        {"type": "point", "x": 1, "y": 2.718, "label": "(1 ; e)", "couleur": "jaune", "position_label": "hg"}
      ]
    },
    {
      "sous_titre": "Sa tangente en 0 a pour équation y = x + 1.",
      "actions": [
        {"type": "tangente", "expr": "exp(x)", "x0": 0, "longueur": 3.4, "couleur": "jaune", "label": "y = x + 1", "position_label": "bd"}
      ]
    },
    {
      "sous_titre": "Sa dérivée e^{x} est toujours > 0 : elle est strictement croissante !",
      "actions": [
        {"type": "formule", "ligne": 3, "texte": "e^{x} > 0", "couleur": "vert"}
      ]
    },
    {
      "sous_titre": "La règle d'or : une somme dans l'exposant devient un produit.",
      "actions": [
        {"type": "effacer", "cible": "formules"},
        {"type": "formule", "ligne": 1, "texte": "e^{a+b} = e^{a} × e^{b}", "couleur": "jaune", "encadre": true}
      ]
    },
    {
      "sous_titre": "À retenir ! Prochain épisode : les équations avec e^{x}.",
      "duree_min": 3,
      "actions": [
        {"type": "formule", "ligne": 2, "texte": "(e^{x})' = e^{x}", "couleur": "rose", "encadre": true}
      ]
    }
  ]
}
